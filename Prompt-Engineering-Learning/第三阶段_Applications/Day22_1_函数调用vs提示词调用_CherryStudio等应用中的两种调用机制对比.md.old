## 第三部分:两种调用的技术实现细节

### 3.1 提示词调用的实现(简单)

```python
class PromptTemplateManager:
    """提示词模板管理器"""

    def __init__(self):
        self.templates = {}

    def register_template(self, name, template, variables):
        """注册提示词模板"""
        self.templates[name] = {
            "template": template,
            "variables": variables
        }

    def call_template(self, template_name, **kwargs):
        """调用提示词模板"""
        template_info = self.templates.get(template_name)

        if not template_info:
            raise ValueError(f"模板 {template_name} 不存在")

        # 简单的变量替换(实际应用会用更复杂的模板引擎)
        prompt = template_info["template"]

        for var_name, var_value in kwargs.items():
            placeholder = "{{" + var_name + "}}"
            prompt = prompt.replace(placeholder, str(var_value))

        return prompt


# ========== 使用示例 ==========
manager = PromptTemplateManager()

# 注册模板
manager.register_template(
    name="翻译",
    template="""请将以下文本翻译成{{target_language}}:

{{text}}

只输出翻译结果,不要添加任何解释。""",
    variables=["target_language", "text"]
)

# 调用模板
final_prompt = manager.call_template(
    "翻译",
    target_language="英文",
    text="你好,世界"
)

print("生成的最终提示词:")
print(final_prompt)

# 输出:
# 请将以下文本翻译成英文:
#
# 你好,世界
#
# 只输出翻译结果,不要添加任何解释。

# 然后把这个提示词发送给LLM
# response = llm.generate(final_prompt)
```

### 3.2 函数调用的实现(复杂)

```python
import json
import requests

class FunctionCallManager:
    """函数调用管理器"""

    def __init__(self, llm_client):
        self.llm_client = llm_client
        self.functions = {}
        self.api_keys = {}

    def register_function(self, function_definition, executor):
        """
        注册函数
        function_definition: OpenAI格式的函数定义
        executor: 实际执行函数的callable
        """
        name = function_definition["function"]["name"]
        self.functions[name] = {
            "definition": function_definition,
            "executor": executor
        }

    def set_api_key(self, service, api_key):
        """设置API密钥"""
        self.api_keys[service] = api_key

    def call_function(self, user_message):
        """完整的函数调用流程"""

        # Step 1: 准备消息
        messages = [{"role": "user", "content": user_message}]

        # Step 2: 准备函数定义列表
        tools = [func["definition"] for func in self.functions.values()]

        # Step 3: 调用LLM(让它决定是否调用函数)
        response = self.llm_client.chat.completions.create(
            model="gpt-4",
            messages=messages,
            tools=tools
        )

        message = response.choices[0].message

        # Step 4: 检查是否需要调用函数
        if not message.tool_calls:
            # 不需要调用函数,直接返回LLM的回答
            return message.content

        # Step 5: 处理函数调用
        for tool_call in message.tool_calls:
            function_name = tool_call.function.name
            function_args = json.loads(tool_call.function.arguments)

            print(f"🔧 调用函数: {function_name}")
            print(f"   参数: {function_args}")

            # 执行函数
            func_info = self.functions.get(function_name)
            if func_info:
                executor = func_info["executor"]
                result = executor(**function_args)

                print(f"   结果: {result}")

                # 将结果添加到对话
                messages.append({
                    "role": "assistant",
                    "content": None,
                    "tool_calls": [tool_call]
                })

                messages.append({
                    "role": "tool",
                    "tool_call_id": tool_call.id,
                    "name": function_name,
                    "content": json.dumps(result)
                })

        # Step 6: 再次调用LLM整合结果
        final_response = self.llm_client.chat.completions.create(
            model="gpt-4",
            messages=messages
        )

        return final_response.choices[0].message.content


# ========== 使用示例 ==========

# 定义实际的函数执行器
def get_weather_executor(location, unit="celsius"):
    """实际调用天气API"""
    api_key = "your_weather_api_key"
    url = f"https://api.weatherapi.com/v1/current.json?key={api_key}&q={location}"

    try:
        response = requests.get(url)
        data = response.json()

        return {
            "location": location,
            "temperature": data["current"]["temp_c"] if unit == "celsius" else data["current"]["temp_f"],
            "condition": data["current"]["condition"]["text"],
            "humidity": data["current"]["humidity"]
        }
    except Exception as e:
        return {"error": str(e)}


# 初始化管理器
import openai
manager = FunctionCallManager(llm_client=openai)

# 注册函数
manager.register_function(
    function_definition={
        "type": "function",
        "function": {
            "name": "get_weather",
            "description": "获取指定城市的实时天气",
            "parameters": {
                "type": "object",
                "properties": {
                    "location": {"type": "string"},
                    "unit": {"type": "string", "enum": ["celsius", "fahrenheit"]}
                },
                "required": ["location"]
            }
        }
    },
    executor=get_weather_executor
)

# 调用
result = manager.call_function("伦敦现在的天气如何?")
print(result)
```

---

## 第四部分:何时使用哪种调用?

### 4.1 决策树

```python
使用决策 = """

用户需求
    ↓
是否需要获取实时数据或执行外部操作?
    ├─ 是 → 使用函数调用(Function Calling)
    │         ├─ 实时天气、新闻、股票 → get_weather(), get_news()
    │         ├─ 数据库查询 → query_database()
    │         ├─ 发送邮件、下单 → send_email(), place_order()
    │         └─ 精确计算 → calculator(), execute_code()
    │
    └─ 否 → 是否需要特定输出格式或风格?
              ├─ 是 → 使用提示词调用(Prompt Calling)
              │         ├─ 翻译、总结、润色 → 翻译模板、总结模板
              │         ├─ JSON格式输出 → JSON模板
              │         ├─ 代码审查、解释 → 代码模板
              │         └─ 特定风格(正式、幽默) → 风格模板
              │
              └─ 否 → 直接对话,无需特殊调用

"""

print(使用决策)
```

### 4.2 实际应用场景对比

```python
应用场景对比 = {
    "场景1: 查询天气": {
        "需求": "用户问'北京现在的天气如何?'",
        "应该用": "函数调用",
        "原因": "需要获取实时天气数据",
        "实现": "调用get_weather('北京') → 返回实际天气"
    },

    "场景2: 翻译文本": {
        "需求": "用户说'把这段话翻译成英文'",
        "应该用": "提示词调用",
        "原因": "LLM本身就会翻译,只需要规范输出格式",
        "实现": "使用翻译模板 → LLM翻译 → 只输出结果"
    },

    "场景3: 数据库查询": {
        "需求": "用户问'我的账户余额是多少?'",
        "应该用": "函数调用",
        "原因": "需要查询实际的数据库",
        "实现": "调用query_database(user_id) → 返回余额"
    },

    "场景4: 代码审查": {
        "需求": "用户说'审查这段代码'",
        "应该用": "提示词调用",
        "原因": "LLM本身会审查代码,只需要结构化输出",
        "实现": "使用代码审查模板 → LLM分析 → 结构化输出"
    },

    "场景5: 精确计算": {
        "需求": "用户问'35628乘以89453等于多少?'",
        "应该用": "函数调用",
        "原因": "LLM计算可能出错,需要调用计算器",
        "实现": "调用calculator('35628 * 89453') → 返回精确结果"
    },

    "场景6: 文章总结": {
        "需求": "用户说'用3句话总结这篇文章'",
        "应该用": "提示词调用",
        "原因": "LLM会总结,只需要规范句数和格式",
        "实现": "使用总结模板 → LLM总结 → 3句话输出"
    }
}
```

---

## 第五部分:两种调用的组合使用

### 5.1 复杂场景:同时使用两种调用

```python
# 场景:智能旅行助手

用户问题 = "我想去北京旅游,帮我查一下明天的天气,并给我制定一个旅游计划"

# 处理流程:
流程 = {
    "Step 1": {
        "类型": "函数调用",
        "操作": "调用get_weather('北京', date='明天')",
        "结果": "明天北京天气:晴,温度15-25℃"
    },

    "Step 2": {
        "类型": "提示词调用",
        "操作": "使用'旅游计划生成模板'",
        "模板": """请根据以下信息制定旅游计划:

目的地: {{destination}}
天气情况: {{weather}}
日期: {{date}}

要求:
1. 根据天气推荐合适的景点和活动
2. 制定详细的时间安排
3. 给出穿衣和装备建议
4. 以Markdown格式输出
""",
        "变量填充": {
            "destination": "北京",
            "weather": "晴,15-25℃",
            "date": "明天"
        }
    },

    "Step 3": {
        "类型": "LLM生成",
        "操作": "基于天气数据和模板,生成详细旅游计划"
    }
}

# 完整实现
class SmartTravelAssistant:
    """智能旅行助手:结合函数调用和提示词调用"""

    def __init__(self, llm_client):
        self.function_manager = FunctionCallManager(llm_client)
        self.template_manager = PromptTemplateManager()

        # 注册函数
        self.function_manager.register_function(
            function_definition={
                "type": "function",
                "function": {
                    "name": "get_weather",
                    "description": "获取天气信息",
                    "parameters": {
                        "type": "object",
                        "properties": {
                            "location": {"type": "string"},
                            "date": {"type": "string"}
                        },
                        "required": ["location"]
                    }
                }
            },
            executor=lambda location, date=None: {
                "location": location,
                "date": date or "今天",
                "condition": "晴",
                "temperature_range": "15-25℃"
            }
        )

        # 注册模板
        self.template_manager.register_template(
            name="旅游计划",
            template="""请根据以下信息制定旅游计划:

目的地: {{destination}}
天气情况: {{weather}}
日期: {{date}}

要求:
1. 根据天气推荐合适的景点和活动
2. 制定详细的时间安排
3. 给出穿衣和装备建议
4. 以Markdown格式输出
""",
            variables=["destination", "weather", "date"]
        )

    def plan_trip(self, destination, date):
        """制定旅游计划"""

        # Step 1: 函数调用获取天气
        print("📞 Step 1: 调用天气API获取实时数据...")
        weather_result = self.function_manager.call_function(
            f"查询{destination}在{date}的天气"
        )

        print(f"   天气: {weather_result}")

        # Step 2: 提示词调用生成计划
        print("\n📝 Step 2: 使用旅游计划模板...")
        prompt = self.template_manager.call_template(
            "旅游计划",
            destination=destination,
            weather=f"{weather_result['condition']}, {weather_result['temperature_range']}",
            date=date
        )

        print("   生成的提示词:")
        print(prompt)

        # Step 3: LLM生成最终计划
        print("\n🤖 Step 3: LLM生成旅游计划...")
        # final_plan = llm.generate(prompt)
        # return final_plan


# 使用
assistant = SmartTravelAssistant(llm_client=None)
assistant.plan_trip("北京", "明天")
```

