            "count": {"type": "number", "default": 10}
        },
        "requires_api_key": True,
        "category": "信息检索"
    },

    "execute_python": {
        "name": "execute_python",
        "description": "执行Python代码",
        "executor": "local_sandbox",  # 本地沙箱执行
        "parameters": {
            "code": {"type": "string", "required": True},
            "timeout": {"type": "number", "default": 30}
        },
        "requires_api_key": False,
        "category": "代码执行"
    }
}
```

