## 第二部分:CherryStudio等应用中的实现

### 2.1 为什么要分成两种?

```python
为什么分成两种 = {
    "应用场景不同": {
        "函数调用": [
            "需要获取实时数据(天气、新闻、股票等)",
            "需要访问外部系统(数据库、API、文件系统)",
            "需要执行实际操作(发邮件、下单、修改数据)",
            "需要精确计算(调用计算器、代码执行器)"
        ],
        "提示词调用": [
            "需要特定格式的回答(JSON、表格、代码等)",
            "需要特定风格的输出(正式、幽默、简洁等)",
            "需要遵循特定流程(思维链、逐步推理等)",
            "常用任务快捷方式(翻译、总结、润色等)"
        ]
    },

    "技术实现不同": {
        "函数调用": {
            "难度": "高(需要API集成、错误处理、安全控制)",
            "成本": "可能产生外部API调用费用",
            "权限": "需要授权访问外部系统",
            "风险": "可能产生副作用(如发邮件、修改数据)"
        },
        "提示词调用": {
            "难度": "低(只需管理提示词模板)",
            "成本": "只产生LLM推理费用",
            "权限": "不需要外部授权",
            "风险": "无副作用,只影响输出格式"
        }
    },

    "用户体验不同": {
        "函数调用": "需要配置函数定义和权限,复杂但功能强大",
        "提示词调用": "开箱即用,简单但功能有限"
    }
}
```

### 2.2 CherryStudio中的典型实现

```python
# ============ CherryStudio中的提示词调用示例 ============
提示词模板库 = {
    "翻译": {
        "name": "翻译",
        "description": "将文本翻译成指定语言",
        "template": """请将以下文本翻译成{{target_language}}:

{{text}}

只输出翻译结果,不要添加任何解释。""",
        "variables": ["target_language", "text"],
        "category": "语言处理"
    },

    "总结": {
        "name": "文章总结",
        "description": "总结文章的核心内容",
        "template": """请用{{num_sentences}}句话总结以下文章的核心内容:

{{article}}

要求:
- 抓住主要观点
- 语言简洁明了
- 保持客观中立""",
        "variables": ["num_sentences", "article"],
        "category": "内容处理"
    },

    "代码审查": {
        "name": "代码审查",
        "description": "审查代码并给出改进建议",
        "template": """请审查以下{{language}}代码:

```{{language}}
{{code}}
```

请从以下维度分析:
1. 代码质量
2. 潜在问题
3. 性能优化建议
4. 最佳实践建议""",
        "variables": ["language", "code"],
        "category": "编程辅助"
    },

    "JSON格式化": {
        "name": "JSON格式输出",
        "description": "按JSON格式提取信息",
        "template": """从以下文本中提取信息,并以JSON格式输出:

{{text}}

JSON格式要求:
{{json_schema}}

只输出有效的JSON,不要添加其他内容。""",
        "variables": ["text", "json_schema"],
        "category": "数据处理"
    }
}

# ============ CherryStudio中的函数调用示例 ============
函数定义库 = {
    "get_weather": {
        "name": "get_weather",
